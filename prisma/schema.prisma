generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model PopupSettings {
  id              String   @id @default(cuid())
  shop            String   @unique
  title           String   @default("Welcome to our store!")
  message         String   @default("Get 10% off your first order. Use code WELCOME10")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  colorStart      String   @default("#667eea")
  colorEnd        String   @default("#764ba2")
  buttonText      String   @default("Shop Now!")
  messageSize     String   @default("16")
  textAlign       String   @default("left")
  titleSize       String   @default("22")
  fontFamily      String   @default("inherit")
  liquidGlass     Boolean  @default(false)
  messageColor    String   @default("#4a5568")
  titleColor      String   @default("#ffffff")
  buttonTextColor String?  @default("#ffffff")
  glassGradient   Boolean? @default(false)
  promoCode        String?  @default("")
}

// ⚠️ Le modèle `BannerSettings` a été retiré d'ici le 2026-08-20.
//
// Il n'a jamais été créé par une migration de popup-pop : il est arrivé par
// un `prisma db pull` sur une base Neon qui hébergeait aussi la table de
// LinguaBar. Aucun code de cette app ne le référençait.
//
// Le retirer du schéma ne touche à aucune base — ça supprime seulement
// l'accesseur `prisma.bannerSettings` du client généré, donc tout risque
// que popup-pop lise ou écrive dans les données de LinguaBar.
//
// NE JAMAIS lancer `prisma migrate dev` sur ce projet sans lire le SQL
// proposé : Prisma verra la table comme un écart et proposera un
// `DROP TABLE "BannerSettings"`. Si la base est partagée avec LinguaBar,
// cela détruirait ses données en production. `prisma migrate deploy`, lui,
// ne rejoue que les migrations existantes et reste sans danger.
